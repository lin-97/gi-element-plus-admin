# 生产环境配置（复制为 backend/env/.env.prod 后修改）
ENVIRONMENT=prod
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
DEBUG=false
LOGGER_LEVEL=INFO

# 安全：部署前务必修改
SECRET_KEY=change-me-to-a-random-secret-key

# 数据库（MySQL 示例，也可改为 postgres）
DATABASE_TYPE=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=gi_admin
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=gi_admin

# Redis
REDIS_ENABLE=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB_NAME=1
REDIS_PASSWORD=your_redis_password

# CORS（GitHub Pages 前端域名）
ALLOW_ORIGINS=["https://lin-97.github.io"]
